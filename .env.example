# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CMS_URL: the Pegasus admin (dashboard) that manages this site's content, e.g. https://admin.pegasushairtools.com
# SITE_SECRET: same value as SITE_SECRET on the admin deployment.
# Without these the site runs on its built-in copy (content/defaults.json) and the forms are disabled.
CMS_URL=
SITE_SECRET=

# MASTERCLASS_URL (optional): where the menu's Masterclass link goes. Defaults to <CMS_URL>/start.
MASTERCLASS_URL=
